# Copy this file to .env and replace the placeholder. Never commit .env.
# Neon dashboard -> your project -> Connection details (pooled connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Passwords for the demo accounts created by `npm run db:seed` (staff, manager, requester).
# Choose your own, at least 8 characters. Never commit the real values.
SEED_STAFF_PASSWORD="change-me-staff"
SEED_MANAGER_PASSWORD="change-me-manager"
SEED_REQUESTER_PASSWORD="change-me-requester"
